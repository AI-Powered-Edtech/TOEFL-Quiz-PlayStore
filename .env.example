# TOEFL Quiz VIL Backend — Environment Variables
# Copy to .env and fill in values

# Server
PORT=8082
DATABASE_URL=sqlite:data.db

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY_SECS=900
JWT_REFRESH_EXPIRY_SECS=604800

# AI (Groq)
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Admin
ADMIN_PASSCODE_HASH=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://toeflquiz.vastar.ai

# Production: Infisical (overrides above)
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENVIRONMENT=production
# INFISICAL_HOST=http://10.10.0.11:8080

# ── VWFD Companion (workflows/) ──
# When set, vwfd-app connects sqlx pool used by vastar.db.sqlite Connector.
# Point at the SAME SQLite file the main backend uses (DATABASE_URL).
VIL_DATABASE_URL=sqlite://data.db
VIL_WORKFLOWS_DIR=workflows
VIL_BIND_ADDR=127.0.0.1:8083
