VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# Database URL (Used for Prisma, Supabase CLI, Node scripts)
DATABASE_URL="postgres://postgres.your-project:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Services
VITE_YOUTUBE_API_KEY="your-youtube-api-key"
# NOTE: VITE_GROQ_API_KEY is NO LONGER needed in the client-side .env file structure.
# Provide the Groq API key securely in Supabase Edge Functions.

# Debug Flags (Optional)
# Enable debug logging for quiz generator (useful for troubleshooting Written Expression questions)
# VITE_DEBUG_QUIZ_GENERATOR="true"
