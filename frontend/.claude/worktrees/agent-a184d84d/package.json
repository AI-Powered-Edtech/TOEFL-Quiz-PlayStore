{
  "name": "toefl-quiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "infra:setup": "bash scripts/setup-infrastructure.sh",
    "infra:start": "docker-compose up -d",
    "infra:stop": "docker-compose down",
    "infra:logs": "docker-compose logs -f",
    "test:load": "k6 run tests/load/logic-weaver-load-test.js",
    "test:load:steady": "k6 run --scenarios steady_state tests/load/logic-weaver-load-test.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest",
    "test:unit": "vitest run",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:bundle": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "android:publish": "npm run android:sync && cd android && ./gradlew bundleRelease publishBundle",
    "release:tag": "bash scripts/release-tag.sh",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.1",
    "@capgo/native-purchases": "^8.0.24",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.38.0",
    "@langchain/groq": "^1.0.4",
    "@sentry/react": "^8.55.0",
    "@sentry/tracing": "^7.120.4",
    "@supabase/supabase-js": "2.39.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/dompurify": "^3.0.5",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "fastest-validator": "^1.18.0",
    "framer-motion": "^12.34.3",
    "idb": "^8.0.3",
    "jsonrepair": "^3.13.2",
    "kokoro-js": "^1.2.1",
    "langchain": "^1.2.16",
    "lucide-react": "^0.562.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^4.1.2",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.7.0",
    "vite-plugin-pwa": "^1.2.0",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.2",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.0.7",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
