# Local Android signing config (DO NOT COMMIT THE REAL FILE)
# Copy this to `keystore.properties` in the same directory and fill in real values.
# Build via Android Studio or: cd frontend/android && ./gradlew bundleRelease
#
# CI uses GitHub Secrets instead of this file (see .github/workflows/android-release.yml):
#   ANDROID_KEYSTORE_BASE64       value: base64 -w0 path/to/keystore.jks
#   ANDROID_KEYSTORE_PASSWORD     value: storepass
#   ANDROID_KEY_ALIAS             value: alias name
#   ANDROID_KEY_PASSWORD          value: keypass
#
# Paths are resolved by frontend/android/app/build.gradle via rootProject.file()
# so `storeFile` is relative to frontend/android/.
# For a local-only debug-signed test build you can point storeFile at
# ~/.android/debug.keystore (storepass=android, alias=androiddebugkey, keypass=android).
# That AAB is NOT acceptable on Play Store production tracks.

storeFile=release.keystore
storePassword=changeme
keyAlias=androiddebugkey
keyPassword=changeme
